{
  "name": "chess-analyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,VITE -c blue,green \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "build": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "chess.js": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "^16.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "express": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
